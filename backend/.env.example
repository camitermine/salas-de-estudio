# Copiar a .env y completar. El .env NUNCA se commitea.

DATABASE_URL=postgresql://salas:salas@localhost:5433/salas

# Modelo de embeddings (corre local, gratis)
EMBEDDINGS_MODELO=intfloat/multilingual-e5-small

# Proveedor del LLM: ollama | gemini | claude
LLM_PROVEEDOR=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b

GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-haiku-5-5
