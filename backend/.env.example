# Copiar a .env y completar. El .env NUNCA se commitea.

DATABASE_URL=postgresql://salas:salas@localhost:5433/salas

# Modelo de embeddings (corre local, gratis)
EMBEDDINGS_MODELO=intfloat/multilingual-e5-small

# Proveedores de LLM en orden de preferencia: si el primero falla
# (por ejemplo, sin créditos), se usa el siguiente.
LLM_PROVEEDORES=claude,gemini

GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash
GEMINI_RAZONAMIENTO=low

ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-haiku-5-5
CLAUDE_ESFUERZO=low
